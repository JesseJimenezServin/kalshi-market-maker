# Config for deploy/push_offbox_backup.sh -- install at /etc/kalshi-offbox.env
# with `chmod 600` (it is read by root only and names a credential profile).
# NOT the same file as the app's .env, and never committed.

# Live database main.py writes on this host.
DB_PATH=/root/kalshi-market-maker/data/paper_trading.sqlite

# rclone remote + bucket/prefix. Configure the remote itself with
# `rclone config` (stored in /root/.config/rclone/rclone.conf, chmod 600).
# Use a credential scoped to PUT/LIST on this one bucket -- it must not be
# able to delete, so a compromise of this host cannot erase the backups it
# is supposed to be protecting. Retention belongs to a bucket lifecycle
# rule, not to this credential.
RCLONE_REMOTE=offbox:kalshi-market-maker-backups

# Failure alerting. Mandatory -- the 2026-10-02 incident was a silent
# failure, not a loud one. Reuse the private topic the 5-minute healthcheck
# already posts to, so there is one place to watch.
NTFY_TOPIC=replace-with-the-private-topic
# NTFY_URL=https://ntfy.sh

# Alert if the source DB has not been written in this many seconds (default
# 3600). A backup that faithfully archives a dead database is still a
# problem worth being told about.
# MAX_DB_AGE_S=3600

# Scratch space for the VACUUM INTO snapshot before compression. Needs free
# space ~= the DB size; the script refuses to start otherwise.
# STAGING_DIR=/var/tmp
