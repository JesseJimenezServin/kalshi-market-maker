[Unit]
Description=Kalshi Market Maker - Phase 0 paper trading (read-only, no real orders)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/kalshi-market-maker
ExecStart=/root/kalshi-market-maker/venv/bin/python3 /root/kalshi-market-maker/main.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
