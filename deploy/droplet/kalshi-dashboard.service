[Unit]
Description=Kalshi Market Maker - read-only dashboard (localhost only, access via SSH tunnel)
After=network-online.target kalshi-market-maker.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/kalshi-market-maker
ExecStart=/root/kalshi-market-maker/venv/bin/python3 /root/kalshi-market-maker/server.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
