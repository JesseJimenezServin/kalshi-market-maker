# Kalshi Liquidity Lab -- environment configuration.
# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real credentials.
#
# Phase 0 is READ-ONLY by design (see config.is_read_only_mode() and the
# GET-only guard in rest_client.py) -- no orders can be placed regardless
# of which environment or credentials are configured below.

# --------------------------------------------------------------------------
# Demo (sandbox, mock funds) -- has NO Liquidity Incentive Program data.
# Useful only for exercising auth/WS/orderbook plumbing against a sandbox,
# not for real market or incentive-program screening.
# --------------------------------------------------------------------------
# KALSHI_ENV=demo
# KALSHI_API_KEY_ID=your-demo-api-key-id
# KALSHI_PRIVATE_KEY_PATH=/absolute/path/to/demo_private_key.pem

# --------------------------------------------------------------------------
# Production (real markets, real incentive programs) -- Phase 0 uses prod
# credentials for real market/incentive DATA ONLY, on an unfunded account.
# This is safe because the codebase is structurally read-only in Phase 0.
# --------------------------------------------------------------------------
KALSHI_ENV=prod
KALSHI_API_KEY_ID=your-prod-api-key-id
KALSHI_PRIVATE_KEY_PATH=/absolute/path/to/prod_private_key.pem
